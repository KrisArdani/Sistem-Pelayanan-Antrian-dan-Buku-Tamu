# ==============================================================================
# SPST BPS Kota Tegal - Server Access Control & Security Configuration (.htaccess)
# ==============================================================================

# Disable Directory Browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS in Production (Active when SSL is enabled on server)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to hidden files and directories (e.g. .git, .env)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Block direct public access to internal application directories
    RewriteRule ^(includes|cache|sql|scratch|vendor)/ - [F,L]
</IfModule>

# Block direct public access to sensitive file extensions & package metadata
<FilesMatch "\.(sql|env|log|md|lock|bak|dump|sqlite|ini|sh|dist)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.json|package\.json)$">
    Require all denied
</FilesMatch>

# Block direct access to sensitive standalone PHP scripts
<FilesMatch "^(config\.php|security\.php|auth_check\.php|seed_webgis\.php)$">
    Require all denied
</FilesMatch>

# Set Security Headers via Apache mod_headers if enabled
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
