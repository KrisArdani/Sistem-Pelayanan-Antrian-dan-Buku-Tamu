# SPST BPS Kota Tegal - Environment Configuration Template
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan konfigurasi lokal/server Anda.

# Environment: 'development' atau 'production'
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_spst

# Security Configuration
CSRF_TOKEN_NAME=spst_csrf_token
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Web API BPS Credentials (Dapatkan API Key resmi di webapi.bps.go.id)
BPS_API_KEY=your_bps_web_api_key_here
BPS_API_BASE=https://webapi.bps.go.id/v1/api
BPS_DOMAIN_KOTA_TEGAL=3376
BPS_DOMAIN_PROV_JATENG=3300
BPS_DOMAIN_PUSAT=0000
BPS_CACHE_TTL=86400
